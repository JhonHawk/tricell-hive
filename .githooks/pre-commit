#!/usr/bin/env bash
# pre-commit — generated outputs travel in the same commit as their canonical sources.
#
# Enabled per clone (git never versions hook activation):
#     git config core.hooksPath .githooks
#
# When a canonical input of harness/build.py or harness/hive-compile.py is staged,
# regenerate every derived artifact and stage it. Derived trees are 100% output,
# so staging everything under them is correct by construction; a hand-edited
# output makes build.py refuse, which aborts the commit with its message.
# Known limit: the generators read the working tree, not the index — a
# partially staged source (`git add -p`) regenerates from the full file.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
cd "$ROOT"

readonly -a SOURCES=(global/ harness/build.py harness/build/ harness/hive-compile.py)
# Every output harness/build.py writes. Keep in step with its
# GENERATED_TREE_RELATIVE_PATHS + GENERATED_FILE_RELATIVE_PATHS: an entry the
# build regenerates but this array omits is rebuilt and then left OUT of the
# commit, so the commit lands with a stale generated file and the next
# `build.py --check` fails on a machine that changed nothing.
readonly -a GENERATED=(
  global/CLAUDE.md
  harness/AGENTS.md
  harness/agents-skills
  harness/claude
  harness/rule-manifest.json
  harness/codex/agents
  harness/opencode/agents
  harness/grok/agents
  harness/pi/agents
)

if git diff --cached --quiet -- "${SOURCES[@]}"; then
  exit 0
fi

echo "pre-commit: canonical sources staged — regenerating harness/ and the hive profile" >&2
python3 harness/build.py 1>&2
git add -A -- "${GENERATED[@]}"

# The profile block lives inside a hand-written file: refresh it only when the
# compiled body actually differs (--check is content-based; a stamp-only refresh
# is churn) and the rest of AGENTS.md carries no unstaged edits a `git add`
# would sweep in.
if git diff --quiet -- AGENTS.md; then
  if ! python3 harness/hive-compile.py . --check 1>&2; then
    python3 harness/hive-compile.py . --apply 1>&2
    git add -- AGENTS.md
  fi
else
  echo "pre-commit: AGENTS.md has unstaged edits — hive profile NOT refreshed; run harness/hive-compile.py . --apply after committing them" >&2
fi
