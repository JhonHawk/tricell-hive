.DS_Store
.idea
*.swp
*.swo
*~
CLAUDE.local.md
**/.claude.json
.firecrawl
audit-coverage-gaps.html
# Preserve only the workspace skeleton, never local scratch or retirement scripts
_support/workspace/*
!_support/workspace/.gitkeep
!_support/workspace/hive-retirement/
_support/workspace/hive-retirement/*
!_support/workspace/hive-retirement/.gitkeep
# Machine-local recovery kits (personal harness configs, third-party plugin snapshots,
# client-named migration records) — referenced by Engram, never committed
_support/backup/
# Large copyrighted reference binaries — distilled into global/rules-situational/ui-visual-design.md; reproducible, never committed
_support/refactoring-ui/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Engram: track only the project identity, not local sync chunks
.engram/*
!.engram/config.json

# Generated distribution artifacts are never versioned
/dist/

# Private optional research sources
/_support/workspace/
/CLAUDE.local.md
