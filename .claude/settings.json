{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-line-count.sh\"",
            "timeout": 10,
            "statusMessage": "Checking agent line count..."
          }
        ]
      }
    ]
  }
}
