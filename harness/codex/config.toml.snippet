# Flow pack — additions for ~/.codex/config.toml
# Merge into the existing file (do not replace).

# AGENTS.md truncation airbag. Codex's default project_doc_max_bytes is 32 KiB
# and it truncates SILENTLY past it. The budget covers the PROJECT chain only —
# every AGENTS.md from the git root down to the cwd. The global
# ~/.codex/AGENTS.md is NOT charged against it: Codex reads it whole into a
# separate field, and the counter is initialized after that (verified in source
# 2026-08-18 and reproduced — an 80 KiB project doc truncated while the 30 KiB
# global stayed intact). So a fat global does NOT starve the repo docs; its own
# size is a context-cost question that no harness caps — harness/build.py reports
# it and enforces nothing.
# 64 KiB is for the CHAIN: this hub's own root + harness AGENTS.md exceed the
# 32 KiB default on their own.
# TOML note: this is a top-level key — it must stay ABOVE the [agents] table.
project_doc_max_bytes = 65536

# Commit attribution. Codex appends a "Codex <noreply@openai.com>" co-author
# trailer to every commit by default. The git-workflow rule forbids ANY AI
# attribution (no "Co-Authored-By", no "Generated with"), so disable it — an
# empty string removes the trailer entirely. Top-level key: keep it ABOVE the
# [agents] table.
commit_attribution = ""

# DO NOT set model_instructions_file. `engram setup` (Codex) re-adds it pointing at
# ~/.codex/engram-instructions.md, which REPLACES Codex's base system prompt (verified
# in codex-rs) and reloads the verbose Engram protocol. The Engram memory protocol
# reaches Codex via the engram-memory-tail.md section of ~/.codex/AGENTS.md instead
# (additive, TUI-invisible). If this key reappears, delete it and re-run /deploy-global.
# See harness/codex/README.md > "Engram memory".

# Subagent coordination for flow-build style sessions (defaults shown; tune as needed)
[agents]
max_threads = 6
max_depth = 1
# Floor for agents the hive leaves on "inherit" (review-refuter, sdd-design,
# cloud-architect, visual-designer) — all judgment roles, so they must not follow a
# session running on a cheap tier. Precedence: agent file > spawn value > these
# defaults > parent session, so a tier-mapped agent's own TOML still wins.
default_subagent_model = "gpt-5.6-sol"
default_subagent_reasoning_effort = "high"

# Linear MCP — required by flow-specs / flow-plan / flow-build. Example shape; adjust to the
# actual server you use (or Codex's native Linear integration if configured).
# [mcp_servers.linear]
# url = "https://mcp.linear.app/mcp"
