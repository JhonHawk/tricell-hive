// OpenCode V1 flow pack — additions for ~/.config/opencode/opencode.json
// Merge these keys into the existing config (do not replace the file).
{
  // NOTE — removed: `"plugin": ["opencode-rules@0.6.4"]`. The glob-scoped rule
  // channel is retired; opencode now reads those rules through the router
  // skills' references, like Codex and PI. Delete the key from your live
  // ~/.config/opencode/opencode.json — merging this file does not remove it.

  // Session sharing. opencode can upload full session history to its servers
  // (opncd.ai/s/<id>). Client code must never leave the
  // machine by default — disable it globally. /share can still opt in per-session.
  "share": "disabled",

  // Phase skills are user-invoked gates. opencode ignores Claude's
  // disable-model-invocation, so gate them here: "ask" lets the model propose
  // a flow skill but requires your approval; the /flow-* commands remain the
  // normal entry point. Research remains automatic through the later exception.
  "permission": {
    "skill": {
      "flow-*": "ask",
      "flow-research": "allow"
    },
    // Enforce the git/destructive-op safety floor that git-workflow.md states
    // as prose — here it becomes a hard gate. opencode evaluates these as
    // glob matches where the LAST matching rule wins, so the catch-all "*"
    // goes first and the specific destructive patterns override it to "ask".
    "bash": {
      "*": "allow",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git rebase*": "ask",
      "rm -rf*": "ask"
    }
  },
  // Optional: make the shared rubrics ambient (they are small). The flow
  // skills already reference them by path, so this is reinforcement, not a
  // requirement.
  // "instructions": ["~/.agents/skills/flow-core/references/harness-mechanics.md"],

  // Linear MCP (required by /flow-build and the specs layer). Example shape — adjust to
  // your actual server; restrict to the agents that need it if desired:
  // "mcp": { "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" } }
}

// No shell env is needed for skill discovery. opencode scans both
// ~/.claude/skills and ~/.agents/skills but does not double-list them
// (measured 2026-08-21, `opencode debug skill`: 39 skills, 0 duplicate names,
// ~/.claude/skills absent from every resolved location).
